# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (Default: local SQLite database for zero-friction setup)
DATABASE_URL="file:./dev.db"

# Gold Valuation Parameter (Mock 24K rate as specified in prompt)
GOLD_RATE_24K_PER_GRAM=7000

# Optional LLM API Keys (Supports Gemini, OpenAI, or falls back to built-in Mock Agent)
# If left empty, the server automatically uses the built-in deterministic agent runner.
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=mock
